{
  "name": "notecraft-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "NoteCraft AI Desktop Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:electron-build": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --platform=node --bundle --external:electron",
    "dev": "npm run dev:electron-build && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --platform=node --bundle --external:electron",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.notecraft.desktop",
    "productName": "NoteCraft Desktop",
    "copyright": "Copyright © 2026 NoteCraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteCraft Desktop",
      "artifactName": "NoteCraft-Desktop-Setup-${version}-${arch}.${ext}"
    }
  }
}
